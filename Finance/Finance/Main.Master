    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="Styles/MainStyles.css" rel="stylesheet" />
  
    <style type="text/css">
        #header {
            background-color: #333; /* Black background color */
            position: fixed; /* Make it stick/fixed */
            top: 0; /* Stay on top */
            width: 100%; /* Full width */
            transition: top 0.3s; /* Transition effect when sliding down (and up) */
        }
        li a {
            color: #fff;
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    
</head>
<body>
    <form role="form" data-toggle="validator" runat="server" id="form2">

        <div class="container-flued" id="title-sec" style="position:relative">

            <div class="row">
                  <asp:Label  runat="server" id="thresholdlevel"> </asp:Label>
                <div class="col-md-12 navbar-fixed-top" id="top-navbar" style="background-color: #fff;">
                    <div class="row">
                         <div class="col-md-12">
                            <asp:Image ID="logoImage" runat="server" ImageUrl="~/images/banner.png" AlternateText="Senate Logo" Width="100%" />
                        </div>
                    </div>
                    <div class="row">

                          <div class="col-md-12">
                             
                            
                            <nav class="navbar" style="background-color:#e4931e;">

                                <div class="container-fluid" style="background-color:#e4931e">
                                    <div class="navbar-header">
                                        <a class="navbar-brand" href="Home.aspx" style="color: #fff; font-family: Arial; font-size: 25px;">F & A</a>
                                    </div>
                                     <ul class="nav navbar-nav navbar-right ">
                                         <li><asp:LinkButton ID="LinkButton1" runat="server" OnClick="Logout_Click"><span class="glyphicon glyphicon-log-out"></span>Logout</asp:LinkButton></li>
                                    </ul>
                                <div id="MenusDiv" runat="server">
                                <%--    <ul class="nav navbar-nav" id="mainsearch" runat="server">
                                        <li class="dropdown">
                                            <a href="../SearchItem.aspx">Inventory</a>
                                        </li>
                                    </ul>--%>
                                     <ul class="nav navbar-nav" id="Ul1" runat="server">
                                        <li class="dropdown">
                                            <a class="dropdown-toggle img-rounded" data-toggle="dropdown" href="#">Manage
                                            <span class="caret"></span></a>
                                            <ul class="dropdown-menu">
                                                
                                                <li>
                                                    <a href="ManageFinancialYears.aspx">Financial Years</a>
                                                       <a href="HeadofAccountsList.aspx">Head of Accounts</a>

                                                </li>
                                          </ul>
                                            </li>
                                        </ul> 
                                    <ul class="nav navbar-nav" id="newemployee" runat="server">
                                        <li class="dropdown">
                                            <a class="dropdown-toggle img-rounded" data-toggle="dropdown" href="#">Manage
                                            <span class="caret"></span></a>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <a href="Countries.aspx">Countries</a>

                                                </li>
                                               
                                          </ul>
                                            </li>
                                        </ul>  
                                    </div>
                                </div>
                            </nav>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="container-fluid" style="margin-top:11%;">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
     <script type="text/javascript">
      
         $(document).ready(function () {
             var secret = document.getElementById("thresholdlevel").innerText;
             document.getElementById("motionbadge").innerText=secret;
               
});


         </script>
</body>
</html>
