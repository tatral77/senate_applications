<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="VisitorManagement.Site1" %>
<html>
<head runat="server">
    <title>VMS</title>
    <link href="/Styles/MainStyles.css" rel="stylesheet" />
    <script src="CustomScripts/jquery.min.js"></script>
    <script src="./Scripts/bootstrap.min.js" type="text/javascript"></script>
    <link href="./Content/bootstrap.min.css" rel="stylesheet" />
    <link href="./Content/bootstrap-theme.min.css" rel="stylesheet" />
    <script src="CustomScripts/jquery-ui.min.js"></script>
    <link href="CustomScripts/jquery-ui.css.css" rel="stylesheet" />

    <%-- <link href="Styles/new.css" rel="stylesheet" />--%>
    <style type="text/css">
        #header {
            background-color: #333; /* Black background color */
            position: fixed; /* Make it stick/fixed */
            top: 0; /* Stay on top */
            width: 100%; /* Full width */
            transition: top 0.3s; /* Transition effect when sliding down (and up) */
        }

        li a {
            color: #fff;
        }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body>
    <form role="form" data-toggle="validator" runat="server" id="form2">

        <div class="container-flued">

            <div class="row">
                <div class="col-md-12 navbar-fixed-top img-responsive" style="background-color: #fff; height: 100px;">
                    <div class="row">
                        <div class="col-md-12">
                            <asp:Image ID="logoImage" CssClass="img-responsive" runat="server" ImageUrl="~/images/banner.png" AlternateText="Senate Logo" Width="100%" Style="margin-top: 0px;" />
                        </div>
                        <%--<div class="col-md-8" style="text-align: center">
                            <h3 style="font-family: 'Times New Roman', Times, serif; font-weight: bold; color: #086623">SENATE OF PAKISTAN</h3>
                            <h4 style="font-weight: bold; font-family: Tahoma">QUESTIONS MANAGEMENT SYSTEM</h4>
                        </div>--%>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                           
                            <nav class="navbar" style="background-color: #4a9fe4; margin-top: 5px;">

                                <div class="container-fluid" style="background-color:#4a9fe4">
                                    <div class="navbar-header">
                                        <a class="navbar-brand" href="#" style="color: #fff; font-family: Arial; font-size: 25px;">VMS</a>
                                    </div>
                                    <ul class="nav navbar-nav navbar-right ">
                                        <li>
                                            <asp:LinkButton ID="LinkButton1" runat="server" OnClick="Logout_Click"><span class="glyphicon glyphicon-log-out"></span>Logout</asp:LinkButton></li>
                                    </ul>
                                    <div id="MenusDiv" runat="server">
                                    </div>

                                </div>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="clearfix"></div>
        <div class="container-fluid" style="margin-top: 230px;">
            <div class="row">
                <div class="col-md-12">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </div>
            </div>
        </div>

    </form>
    <script type="text/javascript">
        $(document).ready(function () {
            var questions = document.getElementById("NewQuestions").innerText;
            var motions = document.getElementById("NewMotions").innerText;
            document.getElementById("questionsbadge").innerText = questions;
            document.getElementById("motionsbadge").innerText = motions;

        });


    </script>
</body>
</html>
