<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="Legislation.Site1" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>LIS</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0c3a72" />
    <script src="CustomScripts/jquery.min.js"></script>
    <script>
        // jQuery UI 1.8 (used for the date picker) still reads jQuery.browser, which jQuery 1.9+ removed.
        jQuery.browser = jQuery.browser || { msie: false, mozilla: false, webkit: false, opera: false, version: "0" };
    </script>
    <script src="./Scripts/bootstrap.min.js" type="text/javascript"></script>
    <script src="CustomScripts/jquery-ui.min.js"></script>
    <link href="Styles/MainStyles.css" rel="stylesheet" />
    <link href="./Content/bootstrap.min.css" rel="stylesheet" />
    <link href="./Content/bootstrap-theme.min.css" rel="stylesheet" />
    <link href="CustomScripts/jquery-ui.css.css" rel="stylesheet" />
    <link href="./Styles/modern.css" rel="stylesheet" />
    <script>
        // Reset button on the search pages: clears the first filter panel without reloading the page.
        function clearTextBox() {
            var $p = jQuery(".regularDiv, .qs-filter").first();
            $p.find("input[type=text], textarea").val("");
            $p.find("select").each(function () { this.selectedIndex = 0; });
            $p.find("input[type=checkbox], input[type=radio]").prop("checked", false);
            $p.find("[data-chips]").each(function () { var c = jQuery(this).data("chips"); if (c) { c.clear(); } });
        }
    </script>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="app-shell">
    <form role="form" data-toggle="validator" runat="server" id="form2">

        <div class="app-header" id="title-sec">
            <div class="app-header-inner">
                <asp:Image ID="Image1" runat="server" ImageUrl="~/Images/senate-logo.png" AlternateText="Senate Logo" CssClass="app-emblem" />
                <div class="app-titles">
                    <div class="app-org">SENATE OF PAKISTAN</div>
                    <div class="app-sys">Legislation Management System</div>
                </div>
            </div>
        </div>

        <asp:Label runat="server" ID="thresholdlevel" Style="display: none"></asp:Label>

        <nav class="navbar app-navbar" id="top-navbar">
            <div class="container-fluid">
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#app-nav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>
                    <a class="navbar-brand" href="#">LIS</a>
                </div>
                <div class="collapse navbar-collapse" id="app-nav">
                    <ul class="nav navbar-nav navbar-right">
                        <li id="motionnotification" runat="server"><a href="../NoticeBills.aspx">Bills Received <span runat="server" id="motionbadge" class="badge"><%=GetBills()%></span></a></li>
                        <li>
                            <asp:LinkButton ID="LinkButton1" runat="server" OnClick="Logout_Click"><span class="glyphicon glyphicon-log-out"></span>Logout</asp:LinkButton></li>
                    </ul>
                    <div id="MenusDiv" runat="server">
                    </div>
                </div>
            </div>
        </nav>

        <div class="app-content" id="content">
            <div class="row">
                <div class="col-md-12">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </div>
            </div>
        </div>

    </form>
    <script src='<%= ResolveUrl("~/Scripts/mobilecards.js") %>' type="text/javascript"></script>
    <script src='<%= ResolveUrl("~/Scripts/attachbox.js")+"?v=20260928a" %>' type="text/javascript"></script>
    <script src='<%= ResolveUrl("~/Scripts/senatescan.js")+"?v=20260928a" %>' data-download='<%= ResolveUrl("~/SenateScan/SenateScan.zip") %>' type="text/javascript"></script>
    <script src='<%= ResolveUrl("~/Scripts/qmsdates.js") %>' type="text/javascript"></script>
    <script src='<%= ResolveUrl("~/Scripts/qmschips.js") %>' type="text/javascript"></script>
    <script src='<%= ResolveUrl("~/Scripts/qmspdf.js") %>' type="text/javascript"></script>
</body>
</html>
