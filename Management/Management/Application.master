<%@ Master Language="C#" MasterPageFile="~/Main.Master" AutoEventWireup="true" CodeBehind="Application.master.cs" Inherits="Management.Application" %>

<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server">
    <link href="Styles/MainStyles.css" rel="stylesheet" />
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
    <style type="text/css">
        lis {
            background-color: #00688B;
        }

        li a {
            color: #fff;
        }

        .navbar-fixed-left {
            position: fixed;
            border-radius: 0;
            height: 100%;
            width: 12%;
        }

            .navbar-fixed-left .navbar-nav > li {
                float: none; /* Cancel default li float: left */
            }

            .navbar-fixed-left + .container {
            }

            /* On using dropdown menu (To right shift popuped) */
            .navbar-fixed-left .navbar-nav > li > .dropdown-menu {
                margin-top: -50px;
            }
    </style>

    <asp:ScriptManager ID="ScriptManager1" runat="server"></asp:ScriptManager>

    <div class="container-fluid">
        <div class="row">
            <div class="col-md-2">

                <ul class="nav nav-pills nav-stacked navbar-fixed-left">
                    <li class="active">
                        <asp:HyperLink ID="RolesHL" runat="server" Style="background-color: #2E6444">Roles</asp:HyperLink></li>
                    <li class="active">
                        <asp:HyperLink ID="UsersHL" runat="server" Style="background-color: #2E6444">Users</asp:HyperLink></li>
                    <li class="active">
                        <asp:HyperLink ID="PagesHL" runat="server" Style="background-color: #2E6444">Pages</asp:HyperLink></li>
                     <li class="active">
                        <asp:HyperLink ID="ManageMenusHL" runat="server" Style="background-color: #2E6444">Menus</asp:HyperLink></li>
                   <%-- <li class="active">
                        <asp:HyperLink ID="RoleMenusHL" runat="server" Style="background-color: #2E6444">Role Menus</asp:HyperLink></li>--%>
                   
                </ul>


            </div>

            <%--  <div class="col-md-10" style="position:relative;">
                    <div class="col-md-12 img-rounded " style="text-align:left;background-color:#2E6444;color:white;padding-bottom:5px;">
                        <asp:Label ID="NameLabel" class="LabelName" runat="server" style="font-size:x-large;font-family:Calibri"></asp:Label>
                        <asp:Label ID="DesignationLabel" runat="server" style="font-size:medium" ></asp:Label>
                        <asp:Label ID="BranchLabel" runat="server" style="font-size:medium" ></asp:Label>
                        <asp:Label ID="StatusLabel" runat="server" style="font-size:medium" ></asp:Label>
                         <asp:Label ID="CurrentStatusLbl" runat="server" style="font-size:medium" ></asp:Label>

            </div>--%>


        <div class="col-md-10">
                <div class="col-md-12 img-rounded " style="text-align:left;background-color:#2E6444;color:white;padding-bottom:5px;">
                        <asp:Label ID="NameLabel" class="LabelName" runat="server" style="font-size:x-large;font-family:Calibri"></asp:Label>
                      

            </div>

            <asp:ContentPlaceHolder ID="EmpMenues" runat="server">
            </asp:ContentPlaceHolder>
        </div>
</div>
</asp:Content>
