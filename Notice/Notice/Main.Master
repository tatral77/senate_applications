<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Main.Master.cs" Inherits="Notice.Main" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>NMS</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0c3a72" />
    <script src="CustomScripts/jquery.min.js"></script>
    <script>
        // jQuery UI 1.8 (used for the date picker) still reads jQuery.browser, which jQuery 1.9+ removed.
        jQuery.browser = jQuery.browser || { msie: false, mozilla: false, webkit: false, opera: false, version: "0" };
    </script>
    <script src="./Scripts/bootstrap.min.js" type="text/javascript"></script>
    <script src="CustomScripts/jquery-ui.min.js"></script>
    <link href="Styles/MainStyles.css" rel="stylesheet" />
    <link href="./Content/bootstrap.min.css" rel="stylesheet" />
    <link href="./Content/bootstrap-theme.min.css" rel="stylesheet" />
    <link href="CustomScripts/jquery-ui.css.css" rel="stylesheet" />
    <link href="./Styles/modern.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="app-shell">
    <form role="form" data-toggle="validator" runat="server" id="form2">

        <div class="app-header" id="title-sec">
            <div class="app-header-inner">
                <asp:Image ID="logoImage" runat="server" ImageUrl="~/Images/senate-logo.png" AlternateText="Senate Logo" CssClass="app-emblem" />
                <div class="app-titles">
                    <div class="app-org">SENATE OF PAKISTAN</div>
                    <div class="app-sys">Notice Management System</div>
                </div>
            </div>
        </div>

        <asp:Label Style="display: none" runat="server" ID="NewQuestions"></asp:Label>
        <asp:Label Style="display: none" runat="server" ID="NewMotions"></asp:Label>

        <nav class="navbar app-navbar" id="top-navbar">
            <div class="container-fluid">
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#app-nav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>
                    <a class="navbar-brand" href="#">NMS</a>
                </div>
                <div class="collapse navbar-collapse" id="app-nav">
                    <ul class="nav navbar-nav navbar-right">
                        <li id="Li1" runat="server"><a href="../SentBills.aspx">Bill <span runat="server" id="Span3" class="badge"><%=GetBills()%></span></a></li>
                        <li id="motionnotification" runat="server"><a href="../SentMotions.aspx">Motion <span runat="server" id="motionbadge" class="badge"><%=GetMotions()%></span></a></li>
                        <li id="resolutionnotification" runat="server"><a href="../SentResolutions.aspx">Resolution <span runat="server" id="Span1" class="badge"><%=GetResolutions()%></span></a></li>
                        <li id="questionnotification" runat="server"><a href="../SentQuestion.aspx">Questions <span runat="server" id="questionbadge" class="badge"><%=GetQuestions()%></span></a></li>
                        <li id="MembersLeaves" runat="server"><a href="../MemberLeaveRequest.aspx">Leave Applications <span runat="server" id="Span2" class="badge"><%=GetLeaves()%></span></a></li>
                        <li><a href="../Login.aspx"><span class="glyphicon glyphicon-log-out"></span>Logout</a></li>
                    </ul>
                    <div id="MenusDiv" runat="server">
                    </div>
                </div>
            </div>
        </nav>

        <div class="app-content" id="content">
            <div class="row">
                <div class="col-md-12">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder3" runat="server">
                    </asp:ContentPlaceHolder>
                </div>
            </div>
        </div>

    </form>
    <script src='<%= ResolveUrl("~/Scripts/mobilecards.js") %>' type="text/javascript"></script>
    <script src='<%= ResolveUrl("~/Scripts/qmsdates.js") %>' type="text/javascript"></script>
    <script src='<%= ResolveUrl("~/Scripts/qmschips.js") %>' type="text/javascript"></script>
    <script src='<%= ResolveUrl("~/Scripts/attachbox.js")+"?v=20260928a" %>' type="text/javascript"></script>
    <script src='<%= ResolveUrl("~/Scripts/senatescan.js")+"?v=20260928a" %>' data-download='<%= ResolveUrl("~/SenateScan/SenateScan.zip") %>' type="text/javascript"></script>
</body>
</html>
