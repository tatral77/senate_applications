<%@ Master Language="C#" MasterPageFile="~/Main.Master" AutoEventWireup="true" CodeBehind="OutgoingVisits.master.cs" Inherits="IPR.OutgoingVisits" %>

<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server">
    <%--<link href="Styles/Pages.css" rel="stylesheet" type="text/css" />
    <link href="Styles/SearchList.css" rel="stylesheet" type="text/css" />--%>
    <link href="Styles/MainStyles.css" rel="stylesheet" />
    <script src="Custom/jquery-ui.min.js"></script>
    <link href="Custom/jquery-ui.css.css" rel="stylesheet" />
    <style>
        .ui-autocomplete {
            position: relative;
            cursor: default;
            z-index: 2000 !important;
        }
    </style>
    <style type="text/css">
        lis {
            background-color: #00688B;
        }

        li a {
            color: #fff;
        }

        .navbar-fixed-left {
            position: fixed;
            border-radius: 0;
            height: 100%;
            width: 12%;
        }

            .navbar-fixed-left .navbar-nav > li {
                float: none; /* Cancel default li float: left */
            }

            .navbar-fixed-left + .container {
            }

            /* On using dropdown menu (To right shift popuped) */
            .navbar-fixed-left .navbar-nav > li > .dropdown-menu {
                margin-top: -50px;
            }
    </style>
    <script src="Scripts/jquery.mask.js"></script>
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder1" runat="server">
    <asp:ScriptManager ID="ScriptManager1" runat="server"></asp:ScriptManager>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-2">
                <ul class="nav nav-pills nav-stacked navbar-fixed-left" style="margin-top: 5px;">
                    <li class="active">
                        <asp:HyperLink ID="VisitDetails" runat="server" Style="background-color: #302c2c">Visit Details</asp:HyperLink>
                    </li>
                    <li class="dropdown  active">
                        <asp:HyperLink ID="CompositionHL" runat="server" Style="background-color: #302c2c">Composition</asp:HyperLink>
                    </li>
                    <li class="dropdown  active">
                        <asp:HyperLink ID="TravelScheduleHL" runat="server" Style="background-color: #302c2c">Travel Schedule</asp:HyperLink>
                    </li>
                    <li class="dropdown  active">
                        <asp:HyperLink ID="DACalculationHL" runat="server" Style="background-color: #302c2c">D.A. Calculation</asp:HyperLink>
                    </li>
                      <li class="dropdown  active">
                        <asp:HyperLink ID="Documents" runat="server" Style="background-color: #302c2c">D.A. Sanction</asp:HyperLink>
                    </li>
                    <li>
                            <div class="img-rounded" style="background-color:#febe53;color:#000;padding:5px;">
                <asp:Label ID="countrylbl" runat="server" Style="font-size:medium;padding:2px;font-weight:bold;"></asp:Label><br />
                <asp:Label ID="fromlbl" runat="server" Style="font-size:9pt;padding:2px;"></asp:Label><br />
                <asp:Label ID="tolbl" runat="server" Style="font-size:9pt;padding:2px;"></asp:Label>
                    </div>
               
                    </li>
              
                  </ul>
          </div>
           <div class="col-md-10" style="position: relative;">
                <div class="col-md-12 img-rounded " style="text-align: left; background-color: #febe53; color: #000; padding:5px; margin-top: 5px; font-weight:700">
                    <asp:Label ID="visitlbl" runat="server" Style="font-size: medium;padding:5px;"></asp:Label>

                </div>

                <div class="clearfix"></div>
                <asp:ContentPlaceHolder ID="EmpMenues" runat="server">
                </asp:ContentPlaceHolder>
            </div>
        </div>
    </div>
</asp:Content>
