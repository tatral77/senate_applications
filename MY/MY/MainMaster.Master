<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MainMaster.Master.cs" Inherits="EstablishmentASP.MainMaster" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>HRM</title>
    <link href="Styles/MainStyles.css" rel="stylesheet" />
    <script src="./Jquery/jquery-1.10.2.js" type="text/javascript"></script>
    <script src="./Scripts/bootstrap.min.js" type="text/javascript"></script>
    <link href="./Content/bootstrap.min.css" rel="stylesheet" />
    <link href="./Content/bootstrap-theme.min.css" rel="stylesheet" />
    <link href="./Styles/jquery-ui-1.10.4.custom.css" rel="stylesheet" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <%-- <link href="Styles/new.css" rel="stylesheet" />--%>
    <style type="text/css">
        #header {
            background-color: #333; /* Black background color */
            position: fixed; /* Make it stick/fixed */
            top: 0; /* Stay on top */
            width: 100%; /* Full width */
            transition: top 0.3s; /* Transition effect when sliding down (and up) */
        }
        li a {
            color: #fff;
        }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body>
    <form role="form" data-toggle="validator" runat="server" id="form1">

        <div class="container-flued" id="title-sec">
            <div class="row" >
                <div class="col-md-12 navbar-fixed-top" id="top-navbar" style="background-color: #fff; height: 100px;">
                    <div class="row" >
                        <div class="col-md-12">
                            <asp:Image ID="logoImage" runat="server" ImageUrl="~/images/1.png" AlternateText="Senate Logo" Width="100%" />
                        </div>
                        
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                               <nav class="navbar" style="background-color:#0047b3;">
                                <div class="container-fluid" style="background-image: linear-gradient(198deg,#0047b3,#03e6f6,#0047b3);">
                                    <div class="navbar-header">
                                        <a class="navbar-brand" href="#" style="color: #fff; font-family: Arial; font-size: 25px;">HRM</a>
                                    </div>
                                     <ul class="nav navbar-nav navbar-right ">
                                         <li><a href="../Corrections.aspx">Corrections <span runat="server" id="correctionbadge" class="badge" style="background-color: red"><%=GetCorrections()%></span></a></li>
                                         <li><asp:LinkButton ID="LinkButton1" runat="server" OnClick="Logout_Click"><span class="glyphicon glyphicon-log-out"></span>Logout</asp:LinkButton></li>
                                    </ul>
                                <div id="MenusDiv" runat="server">

                                </div>
                                   
                                </div>
                            </nav>
                        </div>
                    </div>

                </div>
            </div>

        </div>

        <div class="clearfix"></div>
        <div class="container-fluid" id="content" style="margin-top: 290px;">
            <div class="row">
                <div class="col-md-12">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </div>
            </div>
        </div>

    </form>
    <script type="text/javascript">
        $(document).ready(function () {
            if ($(window).width() < 768) {
                $("#top-navbar").addClass("navbar-default");
                $("#top-navbar").removeClass("navbar-fixed-top");
            }
        });
    </script>
</body>
</html>

